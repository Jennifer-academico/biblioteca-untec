<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                              http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Biblioteca Digital UNTEC</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LibroServlet</servlet-name>
        <servlet-class>controller.LibroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LibroServlet</servlet-name>
        <url-pattern>/libros</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrestamoServlet</servlet-name>
        <servlet-class>controller.PrestamoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrestamoServlet</servlet-name>
        <url-pattern>/prestamos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DevolucionServlet</servlet-name>
        <servlet-class>controller.DevolucionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DevolucionServlet</servlet-name>
        <url-pattern>/devolucion</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>